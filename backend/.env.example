# ==============================================================================
# Trade Name Intelligence Service — Backend Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
SERVICE_NAME=trade-name-intelligence-service

# Database (PostgreSQL + asyncpg with pgvector)
# For local Docker setup: postgresql+asyncpg://tnis:tnis_secure_password@localhost:5432/tnis_db
DATABASE_URL=postgresql+asyncpg://tnis:tnis_secure_password@localhost:5432/tnis_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Self-Hosted vLLM Gateway (OpenAI-compatible) (Spec §3.1, §6.2, N5)
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_ANALYZER_MODEL=ded-analyzer-model
VLLM_SUGGESTIONS_MODEL=ded-suggestions-model
LLM_TIMEOUT_SECONDS=2.5
LLM_MAX_RETRIES=1
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN=30
LLM_CACHE_TTL_SECONDS=86400

# Text Embeddings Inference (TEI) (Spec §3.1)
TEI_BASE_URL=http://localhost:8081
EMBEDDING_DIMENSION=768

# Decision Policy Thresholds (Spec §4.1)
POLICY_BLOCK_CONFIDENCE_THRESHOLD=0.85
POLICY_REVIEW_CONFIDENCE_THRESHOLD=0.60
LEXICON_FUZZY_THRESHOLD=90.0

# Shared deterministic availability thresholds and optional activity descriptors
TRADE_NAME_SIMILARITY_REVIEW_THRESHOLD=0.82
TRADE_NAME_BASE_SIMILARITY_THRESHOLD=88
TRADE_NAME_BASE_MIN_CONFIDENCE=0.70
# Comma-separated extra generic descriptors, for example: services,solutions
TRADE_NAME_DESCRIPTORS_EN=
TRADE_NAME_DESCRIPTORS_AR=

# Capability Feature Flags (off | shadow | on) (Spec §5.3, F16)
AI_ANALYZER=off
AI_SUGGESTIONS=off
AI_REVIEWER_BRIEF=off
AI_SEARCH=off
AI_LEXICON_PROPOSALS=off

# Authentication & JWT (Spec §3.1)
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY=
JWT_JWKS_URL=
JWT_CHANNEL_CLAIM=channel
JWT_AUDIENCE=
JWT_ISSUER=

# Observability (Prometheus & OpenTelemetry)
OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
