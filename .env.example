# ==============================================================================
# Trade Name Intelligence Service — Root Environment Variables Reference
# ==============================================================================

# Backend Port & Host (Default: http://localhost:8000)
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=false

# Frontend Port & API Destination (Default: http://localhost:3000)
VITE_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://tnis:tnis_secure_password@localhost:5432/tnis_db
REDIS_URL=redis://localhost:6379/0

# Self-Hosted LLM (vLLM OpenAI-Compatible Endpoint)
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_ANALYZER_MODEL=ded-analyzer-model
VLLM_SUGGESTIONS_MODEL=ded-suggestions-model

# Text Embeddings Inference (TEI)
TEI_BASE_URL=http://localhost:8081
EMBEDDING_DIMENSION=768

# AI Capability Flags (off | shadow | on)
AI_ANALYZER=shadow
AI_SUGGESTIONS=shadow
AI_REVIEWER_BRIEF=shadow
AI_SEARCH=shadow
AI_LEXICON_PROPOSALS=shadow
